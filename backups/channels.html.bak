  <div id="mobile-drawer" class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-slate-950/95 border-l border-[#263247] z-50 transform translate-x-full transition-transform duration-300 ease-in-out p-6 flex flex-col justify-between">
