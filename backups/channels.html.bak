  <!-- Free Trial Modal -->
  <div id="trial-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
    <div id="trial-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
    <div class="relative glass-card-glow bg-[#101522] rounded-2xl max-w-md w-full p-6 sm:p-8 border border-[#263247] shadow-2xl z-10">
      <div class="flex items-center justify-between pb-4 border-b border-[#263247]">
        <div class="flex items-center gap-2">
          <span class="text-xl">⚡</span>
          <h3 class="font-heading font-bold text-lg text-white">Claim 24-Hour Free Trial</h3>
        </div>
        <button id="close-trial-modal" class="text-slate-400 hover:text-white p-1 rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="trial-form" class="mt-6 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Delivery Email Address</label>
          <input type="email" required placeholder="your.name@example.com" class="w-full bg-[#0C111D] border border-[#263247] rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Your Streaming Device</label>
          <select name="device" class="w-full bg-[#0C111D] border border-[#263247] rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="Amazon FireStick">Amazon FireStick 4K / Lite</option>
            <option value="Smart TV (Samsung/LG)">Samsung / LG Smart TV</option>
            <option value="Android TV / Box">Android TV Box / Google TV</option>
            <option value="Apple TV / iOS">Apple TV / iPhone / iPad</option>
            <option value="MAG Box">MAG Box / Stalker</option>
            <option value="Windows / Mac">Windows PC / MacOS</option>
          </select>
        </div>
        <button type="submit" class="btn-primary text-white w-full py-3 rounded-xl text-xs uppercase tracking-wider font-extrabold text-white mt-2">
          Generate Trial Line
        </button>
      </form>
    </div>
  </div>

  <div id="toast-container"></div>

