  <!-- MAIN CONTENT -->
  <main class="flex-grow pt-28 sm:pt-36 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-extrabold uppercase tracking-widest text-blue-400">Content Directory</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold font-heading text-white mt-2">
          Channel & VOD Explorer
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-3">
          Search over <strong>20,000+ live international channels</strong> and <strong>60,000+ 4K movies & series</strong>. Updated daily.
        </p>
      </div>

      <!-- Real-Time Search Bar -->
      <div class="max-w-2xl mx-auto mb-8">
        <div class="relative">
          <input type="text" id="channel-search-input" placeholder="Search channels (e.g. Sky Sports, ESPN, UFC, HBO, BBC, French, Arabic)..." class="w-full bg-[#101522] border border-[#263247] rounded-2xl px-5 py-4 pl-12 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 shadow-xl">
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-lg">
            🔍
          </div>
        </div>
        <div class="flex items-center justify-between text-xs text-slate-400 mt-2.5 px-2">
          <span id="channel-match-count">Loading channels database...</span>
          <span class="text-cyan-400 font-medium">Native 4K & 60FPS</span>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
        <button class="channel-cat-pill active px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-cyan-500/30 transition-all" data-cat="all">All Categories</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="sports">⚽ Sports 4K UHD</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="ppv">🥊 PPV & Events</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="usa">🇺🇸 USA & Canada</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="uk">🇬🇧 UK & Ireland</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="international">🌍 International</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="vod">🍿 4K VOD Movies</button>
        <button class="channel-cat-pill px-4 py-2 rounded-xl text-xs font-semibold bg-[#101522] border border-[#263247] text-slate-300 hover:text-white hover:border-blue-500/50 transition-all" data-cat="kids">🏰 Kids & Family</button>
      </div>

      <!-- Channel Grid Output -->
      <div id="channels-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 min-h-[300px]">
        <!-- Channels will be injected here via channels.js -->
      </div>

      <!-- CTA Bottom Card -->
      <div class="mt-16 glass-panel rounded-3xl p-8 sm:p-12 border border-[#263247] bg-[#101522] text-center">
        <h3 class="text-2xl sm:text-3xl font-extrabold font-heading text-white">
          Can't find a specific channel or sport?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 max-w-xl mx-auto">
          Our master playlist contains over 20,000 channels across 80+ countries. Ask our WhatsApp support team to verify your favorite local feed!
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 mt-6">
          <a href="https://wa.me/447413469398?text=Hello+Luna+Stream!+Does+your+playlist+include+..." target="_blank" class="btn-whatsapp px-6 py-3 rounded-xl text-xs font-bold flex items-center gap-2">
            <span>Ask Channel Request on WhatsApp</span>
          </a>
          <a href="checkout.html" class="btn-primary text-white px-6 py-3 rounded-xl text-xs font-extrabold text-white">
            Get Full Access Pass
          </a>
        </div>
      </div>

    </div>
  </main>

