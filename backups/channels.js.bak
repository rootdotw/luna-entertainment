  { name: "Disney+ & Marvel Cinematic VOD", category: "vod", quality: "4K IMAX Enhanced", country: "VOD", epg: false, icon: "🦸" }
];

let activeCategory = 'all';
let searchQuery = '';

document.addEventListener('DOMContentLoaded', () => {
  initChannelExplorer();
});

function initChannelExplorer() {
  const container = document.getElementById('channels-grid');
  const searchInput = document.getElementById('channel-search-input');
  const categoryPills = document.querySelectorAll('.channel-cat-pill');
  const resultCounter = document.getElementById('channel-match-count');

  if (!container) return;

  function renderChannels() {
    const filtered = CHANNEL_DATABASE.filter(item => {
      const matchesCat = activeCategory === 'all' || item.category === activeCategory;
      const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            item.country.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            item.category.toLowerCase().includes(searchQuery.toLowerCase());
      return matchesCat && matchesSearch;
    });

    if (resultCounter) {
      resultCounter.textContent = `${filtered.length} Channels / Streams Displayed (Sample of 20,000+)`;
    }

    if (filtered.length === 0) {
      const emptyMsg = document.createElement('p');
      emptyMsg.className = 'text-sm text-gray-400 text-center py-8';
      const strong = document.createElement('strong');
      strong.textContent = searchQuery;
      emptyMsg.append('We couldn\\'t find matches for "', strong, '". Our database has over 20,000+ live streams.');
      container.innerHTML = '';
      container.appendChild(emptyMsg);
      return;
    }

    container.innerHTML = filtered.map(ch => `
      <div class="glass-panel rounded-xl p-4 flex items-center justify-between border border-[#263247] hover:border-blue-500/50 bg-[#101522] transition-all duration-200 group">
        <div class="flex items-center space-x-3.5">
          <div class="w-10 h-10 rounded-lg bg-[#0C111D] border border-[#263247] flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-110 transition-transform">
            ${ch.icon}
          </div>
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-blue-400 transition-colors flex items-center gap-2">
              ${ch.name}
              ${ch.epg ? '<span class="px-1.5 py-0.5 text-[10px] bg-slate-800 text-slate-400 rounded font-mono">EPG</span>' : ''}
            </div>
            <div class="text-xs text-slate-400 flex items-center gap-2 mt-0.5">
              <span>📍 ${ch.country}</span>
              <span class="text-slate-600">•</span>
              <span class="text-[#22D3EE] font-medium">${ch.quality}</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
            LIVE
          </span>
        </div>
      </div>
    `).join('');
  }

  // Search input event (debounced 200ms)
  if (searchInput) {
    let debounceTimer = null;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        searchQuery = e.target.value.trim();
        renderChannels();
      }, 200);
    });
  }

  // Category pill event
  categoryPills.forEach(pill => {
    pill.addEventListener('click', () => {
      categoryPills.forEach(p => {
        p.classList.remove('bg-blue-600', 'text-white', 'font-bold', 'shadow-sm');
        p.classList.add('bg-[#101522] border border-[#263247]', 'text-slate-300');
      });

      pill.classList.remove('bg-[#101522] border border-[#263247]', 'text-slate-300');
      pill.classList.add('bg-blue-600', 'text-white', 'font-bold', 'shadow-sm');

      activeCategory = pill.getAttribute('data-cat') || 'all';
      renderChannels();
    });
  });

  renderChannels();
}

